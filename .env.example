# Canonical public origin. This is also the built-in default.
# Match Vercel's primary domain: apex and garibanadam.com redirect to www.
# Set this in Vercel Production and rebuild if the primary domain changes.
SITE_URL=https://www.berkekatranci.com
# Optional Google Search Console HTML-tag verification token (content value only).
# GOOGLE_SITE_VERIFICATION=
#
# Vercel preview/development deployments automatically receive noindex,
# a disallow-all robots.txt, and an empty sitemap.
# This portfolio is static and does not require a database.
#
# If you later add Neon Postgres or another database, create a Neon project,
# copy the pooled connection string, and set DATABASE_URL in Vercel:
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
